{
  "name": "cicd-monorepo-demo",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "cicd-monorepo-demo",
      "version": "1.0.0",
      "license": "MIT",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "version": "1.0.0",
      "dependencies": {
        "shared": "*"
      }
    },
    "apps/mural": {
      "version": "1.0.0",
      "dependencies": {
        "shared": "*"
      }
    },
    "node_modules/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/mural": {
      "resolved": "apps/mural",
      "link": true
    },
    "node_modules/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/shared": {
      "version": "1.0.0"
    }
  }
}
